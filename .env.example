# Copiez ce fichier en .env et remplacez par l'IP locale de votre backend
# (ipconfig / ifconfig), car "localhost" ne fonctionne pas depuis un
# téléphone physique ou certains émulateurs.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3001/api

# Optionnel : connexion Google. Nécessite de créer un Client ID OAuth de
# type "iOS" et/ou "Android" dans Google Cloud Console (distinct du Client ID
# "Web application" utilisé par le frontend) — le bouton reste masqué sans ça.
# Le backend doit connaître ces mêmes valeurs (GOOGLE_CLIENT_ID_MOBILE_IOS /
# _ANDROID dans backend/.env) pour accepter les jetons qu'elles émettent.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
